	"VersionName": "0.1.0",
	"FriendlyName": "RammsNewtonPhysics",
	"Description": "RAMMS plugin integrating the Newton physics engine (newton-physics/newton, GPU-accelerated via NVIDIA Warp) as an alternate solver behind UnrealRoboticsLab's MuJoCo data model. Newton runs out-of-process in a Python worker; this plugin provides the availability probe, ZMQ transport, and the custom step handler that swaps mj_step for Newton stepping.",
	"Category": "Robotics & Simulation",
	"CreatedBy": "RAMMP",
	"CreatedByURL": "https://github.com/rammp-org",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
