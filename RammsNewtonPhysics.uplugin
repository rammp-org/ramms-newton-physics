	"IsBetaVersion": true,
	"IsExperimentalVersion": true,
	"Installed": false,
	"Plugins": [
		{
			"Name": "RammsCore",
			"Enabled": true
		},
		{
			"Name": "UnrealRoboticsLab",
			"Enabled": true
		}
	],
	"Modules": [
		{
			"Name": "RammsNewtonPhysics",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	]
}
